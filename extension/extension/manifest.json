{
  "manifest_version": 3,
  "name": "DFIR Sentinel Live Collector",
  "version": "1.1",
  "description": "Real-time browser history triage and active webmail scanner.",
  "permissions": [
    "history",
    "scripting",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "*://127.0.0.1/*",
    "*://localhost/*"
  ]
}